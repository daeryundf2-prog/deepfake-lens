# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv-*/
venv/
*.egg-info/
dist/
build/

# Test data
*.png
*.jpg
*.jpeg
*.webp
# Committed test fixtures (the C2PA fixture is required by test_c2pa.py and

!fixtures/**/*.png
training_data/
test_datasets/
public_datasets/
ml_classifier.json
test_results.json
model_tracker.json

# Neural checkpoints are research-licensed and never committed;
# fetch them with scripts/fetch_aide.py (see models/aide-runtime.json).
models/*.pth
models/*.pt
models/*.onnx
models/*.torchscript
models/*.bin
models/*.part
models/*.model
models/*.task
models/checkpoints/
deepfake_lens/models/*.pth
deepfake_lens/models/*.pt
deepfake_lens/models/*.onnx
deepfake_lens/models/*.torchscript
deepfake_lens/models/*.bin
deepfake_lens/models/*.part
deepfake_lens/models/*.model
deepfake_lens/models/*.task
deepfake_lens/models/checkpoints/
# Bundled-app model asset — generated/exported locally, never committed
deepfakeclassifier/src/main/assets/*.onnx

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage artifacts (visibility only, no gate)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Adversarial non-photo set — generated, never committed
# (scripts/make_adversarial_fixtures.py; tests generate into a temp dir)
fixtures/adversarial/

# Benchmark smoke report (regenerated by test_benchmark_e2e.py)
benchmark-report.json

# Logs
*.log


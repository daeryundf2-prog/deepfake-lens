# GUI end-to-end smoke image: the reference image plus /venv-gui (main-env packages, pymupdf, Playwright Chromium).
# Build:  docker build -t deepfake-lens-gate:gui -f scripts/gate/Dockerfile.gui scripts/gate
FROM deepfake-lens-gate
RUN python -m venv /venv-gui && /venv-gui/bin/pip install -q "opencv-python>=4.8" "numpy>=1.24" "librosa>=0.10" "scipy>=1.10" "scikit-learn>=1.3" \
      "Pillow>=10.0" "c2pa-python>=0.6" "jsonschema>=4.18" pymupdf playwright && \
    /venv-gui/bin/playwright install --with-deps chromium
WORKDIR /repo

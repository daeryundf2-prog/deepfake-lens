# GUI end-to-end smoke image: the reference image plus /venv-gui (main-env packages, pymupdf, Playwright Chromium).
# Build:  docker build -t deepfake-lens-gate:gui -f scripts/gate/Dockerfile.gui scripts/gate
# R23-10 (round 23): /venv-gui at the exact versions of the reference GUI image (requirements-gui.lock, --no-deps);
# Playwright 1.63.0 installs its own pinned Chromium build (chromium-1243).
FROM deepfake-lens-gate
COPY requirements-gui.lock /tmp/locks/
RUN python -m venv /venv-gui && /venv-gui/bin/pip install -q pip==26.2.1 && \
    /venv-gui/bin/pip install -q --no-deps -r /tmp/locks/requirements-gui.lock && /venv-gui/bin/pip check && \
    /venv-gui/bin/playwright install --with-deps chromium
WORKDIR /repo
